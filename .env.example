# Copy this file to .env and fill in your values

# MongoDB connection string
# Local:   mongodb://localhost:27017/carfun
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net/carfun
MONGO_URI=mongodb://localhost:27017/carfun

# JWT secret — change this to a long random string in production
JWT_SECRET=carfun_super_secret_jwt_key_change_me_in_production

# Server port
PORT=3000

# Node environment
NODE_ENV=development
